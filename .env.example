# Supabase Postgres transaction pooler (used automatically on Vercel/serverless)
# Project Settings -> Database -> Connection string -> Transaction pooler (port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Persistent shop server + migrations. Use the Session pooler on port 5432 for IPv4.
# Non-Vercel runtimes use this URL automatically.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Optional explicit runtime override. Leave empty to use the automatic selection above.
DATABASE_RUNTIME_URL=""

# Shared Prisma pool size on a persistent server (not per employee device).
PRISMA_CONNECTION_LIMIT="10"

# Auth.js / NextAuth
# Generate once with: npx auth secret
# Add the same secret to Vercel for Preview and Production.
AUTH_SECRET="replace-with-a-random-secret"

# Kept for NextAuth v4 compatibility. The app prefers AUTH_SECRET.
NEXTAUTH_SECRET=""

# Local development URL. On Vercel, set this to the production domain only if
# redirects use the wrong host; Auth.js normally detects the Vercel host.
NEXTAUTH_URL="http://localhost:3000"
