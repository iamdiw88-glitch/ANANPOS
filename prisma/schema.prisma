// prisma/schema.prisma
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// === ENUMS ===

enum MovementType {
  PURCHASE_IN
  SALE_OUT
  RETURN_IN
  ADJUST
  DAMAGE_OUT
}

enum RefType {
  SALE
  PURCHASE
  RETURN
  ADJUSTMENT
  DAMAGE
}

enum UserRole {
  OWNER
  CASHIER
  STAFF
}

enum CustomerType {
  CASH
  CREDIT
}

enum PriceTier {
  RETAIL
  CONTRACTOR
}

enum SaleStatus {
  PAID
  UNPAID
  PARTIAL
  VOID
}

enum DocType {
  RECEIPT
  TAX_INVOICE
}

enum PaymentType {
  CASH
  CREDIT
  PARTIAL
}

enum InvoiceStatus {
  OPEN
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHEQUE
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
  FAILED
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  CUSTOMER_RETURN
}

enum RefundMethod {
  CASH
  CREDIT_NOTE
}

enum VehicleStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
}

enum VehicleType {
  TRUCK
  PICKUP
  MOTORCYCLE
  LIFT
  FORKLIFT
  LOADER
  OTHER
}

enum AttendanceMethod {
  MANUAL
  FACE_SCAN
  PIN
}

enum MaintenanceType {
  REPAIR
  SERVICE
  TIRE
  OTHER
}

// === MASTER DATA ===

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  imageUrl  String?    @db.Text
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  parentId  Int?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children  Category[] @relation("SubCategories")
  products  Product[]
}

model Unit {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  abbreviation String?
  baseProducts Product[]     @relation("BaseUnit")
  productUnits ProductUnit[]
}

model Supplier {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String
  phone     String?
  address   String?
  taxId     String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  purchases Purchase[]
}

// === PRODUCT & UOM ===

model Product {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  name         String
  imageUrl     String?  @db.Text
  description  String?
  searchTags   String?
  soldCount    Int      @default(0)
  categoryId   Int
  baseUnitId   Int
  reorderPoint Float    @default(0)
  isStockItem      Boolean  @default(true)
  isActive         Boolean  @default(true)
  barcode          String?  @unique
  barcodeGenerated Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  baseUnit       Unit            @relation("BaseUnit", fields: [baseUnitId], references: [id])
  productUnits   ProductUnit[]
  stockMovements StockMovement[]
  stockBalance   StockBalance?
  saleItems      SaleItem[]
  purchaseItems  PurchaseItem[]
  returnItems    ReturnItem[]
}

model ProductUnit {
  id              Int     @id @default(autoincrement())
  productId       Int
  unitId          Int
  conversionRate  Float
  price           Float
  contractorPrice Float?
  isDefaultSale   Boolean @default(false)
  isActive        Boolean @default(true)
  barcode         String? @unique

  product       Product        @relation(fields: [productId], references: [id])
  unit          Unit           @relation(fields: [unitId], references: [id])
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  returnItems   ReturnItem[]

  @@unique([productId, unitId])
}

// === STOCK ===

model StockBalance {
  productId      Int   @id
  quantityOnHand Float @default(0)

  product Product @relation(fields: [productId], references: [id])
}

model StockMovement {
  id           Int          @id @default(autoincrement())
  productId    Int
  movementType MovementType
  quantityBase Float
  unitCost     Float        @default(0)
  refType      RefType
  refId        Int?
  note         String?
  createdById  Int
  createdAt    DateTime     @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User    @relation(fields: [createdById], references: [id])

  @@index([productId])
  @@index([createdAt])
}

// === USERS ===

model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      UserRole @default(CASHIER)
  pinHash   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stockMovements  StockMovement[]
  salesCreated    Sale[]          @relation("SaleCreatedBy")
  salesVoided     Sale[]          @relation("SaleVoidedBy")
  invoices        Invoice[]
  payments        Payment[]
  deliveries      Delivery[]
  purchases       Purchase[]
  returns         Return[]
  employeeProfile Employee?
}

// === HR ===

model Employee {
  id             Int       @id @default(autoincrement())
  employeeCode   String    @unique
  name           String
  nickname       String?
  role           String    @default("STAFF")
  department     String    @default("SALES_CASHIER")
  position       String?
  employeeType   String    @default("fulltime")
  payType        String    @default("monthly")
  payRate        Float     @default(0)
  phone          String?
  idCard         String?
  startDate      DateTime?
  endDate        DateTime?
  note           String?
  avatarColor    String    @default("#6B7280")
  isActive       Boolean   @default(true)
  userId         Int?      @unique
  faceEmbedding  Bytes?
  faceEnrolledAt DateTime?
  shiftStartTime String?   @default("08:00")
  shiftEndTime   String?   @default("17:00")
  lateGraceMin   Int       @default(15)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user              User?                 @relation(fields: [userId], references: [id])
  attendances       AttendanceLog[]
  unrecognizedScans UnrecognizedScanLog[]
  deliveries        Delivery[]            @relation("DeliveryDriver")
  fuelLogs          FuelLog[]

  @@index([isActive])
  @@index([role])
  @@index([employeeType])
  @@index([name])
}

model AttendanceLog {
  id           Int              @id @default(autoincrement())
  employeeId   Int
  employee     Employee         @relation(fields: [employeeId], references: [id])
  date         DateTime         @db.Date
  checkIn      DateTime?
  checkOut     DateTime?
  workMinutes  Int?
  method       AttendanceMethod @default(MANUAL)
  isLate       Boolean          @default(false)
  deviceId     String?
  note         String?
  recordedById Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  device FaceScanDevice? @relation(fields: [deviceId], references: [id])

  @@unique([employeeId, date])
  @@index([date])
  @@index([employeeId])
}

model FaceScanDevice {
  id         String    @id @default(cuid())
  name       String
  location   String?
  status     String    @default("offline")
  lastPingAt DateTime?
  ipAddress  String?
  apiKey     String?   @unique
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  attendances       AttendanceLog[]
  unrecognizedScans UnrecognizedScanLog[]
}

model UnrecognizedScanLog {
  id                 String    @id @default(cuid())
  deviceId           String
  imageUrl           String?
  confidence         Float?
  status             String    @default("pending")
  resolvedEmployeeId Int?
  resolvedById       Int?
  resolvedAt         DateTime?
  note               String?
  createdAt          DateTime  @default(now())

  device   FaceScanDevice @relation(fields: [deviceId], references: [id])
  employee Employee?      @relation(fields: [resolvedEmployeeId], references: [id])

  @@index([deviceId])
  @@index([status])
  @@index([createdAt])
}

// === CUSTOMERS ===

model Customer {
  id             Int          @id @default(autoincrement())
  code           String       @unique
  name           String
  phone          String?
  address        String?
  taxId          String?
  type           CustomerType @default(CASH)
  creditLimit    Float        @default(0)
  creditTermDays Int          @default(0)
  priceTier      PriceTier    @default(RETAIL)
  balance        Float        @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sales            Sale[]
  invoices         Invoice[]
  payments         Payment[]
  deliveries       Delivery[]
  deliveryProfiles DeliveryCustomer[]
  returns          Return[]

  @@index([name])
  @@index([phone])
}

model DeliveryCustomer {
  id              Int       @id @default(autoincrement())
  name            String
  phone           String    @unique
  phone2          String?
  deliveryAddress String
  subdistrictId   String?
  subdistrictName String?
  moo             Int?
  villageName     String?
  landmark        String?
  totalPurchased  Float     @default(0)
  purchaseCount   Int       @default(0)
  lastPurchasedAt DateTime?
  customerId      Int?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer   Customer?  @relation(fields: [customerId], references: [id])
  deliveries Delivery[]

  @@index([name])
  @@index([phone])
  @@index([totalPurchased])
}

// === SALES ===

model Sale {
  id             Int         @id @default(autoincrement())
  billNo         String      @unique
  customerId     Int?
  saleDate       DateTime    @default(now())
  subtotal       Float
  discountAmount Float       @default(0)
  vatRate        Float       @default(0)
  vatAmount      Float       @default(0)
  grandTotal     Float
  paymentType    PaymentType
  paidAmount     Float       @default(0)
  status         SaleStatus  @default(UNPAID)
  docType        DocType     @default(RECEIPT)
  voidReason     String?
  voidedById     Int?
  voidedAt       DateTime?
  createdById    Int
  createdAt      DateTime    @default(now())

  customer     Customer?     @relation(fields: [customerId], references: [id])
  createdBy    User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  voidedBy     User?         @relation("SaleVoidedBy", fields: [voidedById], references: [id])
  items        SaleItem[]
  deliveries   Delivery[]
  returns      Return[]
  invoiceSales InvoiceSale[]

  @@index([saleDate])
  @@index([customerId])
  @@index([status])
}

model SaleItem {
  id             Int     @id @default(autoincrement())
  saleId         Int
  productId      Int
  productUnitId  Int
  customName     String?
  customUnitName String?
  quantity       Float
  quantityBase   Float
  unitPrice      Float
  discountAmount Float   @default(0)
  lineTotal      Float

  sale        Sale        @relation(fields: [saleId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
}

// === AR (Accounts Receivable) ===

model Invoice {
  id          Int           @id @default(autoincrement())
  invoiceNo   String        @unique
  customerId  Int
  invoiceDate DateTime      @default(now())
  dueDate     DateTime
  totalAmount Float
  paidAmount  Float         @default(0)
  balance     Float
  status      InvoiceStatus @default(OPEN)
  createdById Int
  createdAt   DateTime      @default(now())

  customer     Customer      @relation(fields: [customerId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  invoiceSales InvoiceSale[]
  payments     Payment[]

  @@index([invoiceDate])
  @@index([status])
  @@index([customerId])
}

model InvoiceSale {
  invoiceId Int
  saleId    Int
  amount    Float

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  sale    Sale    @relation(fields: [saleId], references: [id])

  @@id([invoiceId, saleId])
}

model Payment {
  id          Int           @id @default(autoincrement())
  paymentNo   String        @unique
  customerId  Int
  invoiceId   Int?
  amount      Float
  method      PaymentMethod
  paymentDate DateTime      @default(now())
  reference   String?
  note        String?
  createdById Int
  createdAt   DateTime      @default(now())

  customer  Customer @relation(fields: [customerId], references: [id])
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([paymentDate])
  @@index([customerId])
}

// === DELIVERY ===

model Delivery {
  id                 Int            @id @default(autoincrement())
  saleId             Int
  customerId         Int?
  deliveryAddress    String
  recipientName      String?
  recipientPhone     String?
  recipientPhone2    String?
  deliveryCustomerId Int?
  subdistrictId      String?
  subdistrictName    String?
  moo                Int?
  villageName        String?
  landmark           String?
  scheduledDate      DateTime?
  status             DeliveryStatus @default(PENDING)
  driverName         String?
  vehicle            String?
  driverId           Int?
  vehicleId          Int?
  deliveredAt        DateTime?
  isCOD              Boolean        @default(false)
  cashSettledAt      DateTime?
  cashSettledById    Int?
  cashExpectedAmount Float?
  cashActualAmount   Float?
  cashDifference     Float?
  note               String?
  createdById        Int
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  sale             Sale              @relation(fields: [saleId], references: [id])
  customer         Customer?         @relation(fields: [customerId], references: [id])
  deliveryCustomer DeliveryCustomer? @relation(fields: [deliveryCustomerId], references: [id])
  createdBy        User              @relation(fields: [createdById], references: [id])
  driver           Employee?         @relation("DeliveryDriver", fields: [driverId], references: [id])
  assignedVehicle  Vehicle?          @relation(fields: [vehicleId], references: [id])

  @@index([scheduledDate])
  @@index([status])
  @@index([cashSettledAt])
  @@index([deliveryCustomerId])
  @@index([driverId])
  @@index([vehicleId])
}

// === FLEET ===

model Vehicle {
  id               Int           @id @default(autoincrement())
  vehicleCode      String        @unique
  plateNumber      String        @unique
  vehicleType      VehicleType
  brand            String?
  model            String?
  year             Int?
  color            String?
  insuranceExpiry  DateTime?
  taxExpiry        DateTime?
  inspectionExpiry DateTime?
  isActive         Boolean       @default(true)
  status           VehicleStatus @default(AVAILABLE)
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  deliveries      Delivery[]
  fuelLogs        FuelLog[]
  maintenanceLogs MaintenanceLog[]

  @@index([isActive])
  @@index([status])
  @@index([plateNumber])
}

model FuelLog {
  id          Int      @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId    Int
  driver      Employee @relation(fields: [driverId], references: [id])
  liters      Decimal  @db.Decimal(10, 2)
  pricePerLit Decimal? @db.Decimal(10, 2)
  totalCost   Decimal? @db.Decimal(12, 2)
  odometer    Int?
  stationName String?
  note        String?
  fuelDate    DateTime @default(now())
  createdById Int?
  createdAt   DateTime @default(now())

  @@index([vehicleId])
  @@index([driverId])
  @@index([fuelDate])
  @@index([createdAt])
}

model DieselStockLedger {
  id           Int      @id @default(autoincrement())
  type         String
  liters       Decimal  @db.Decimal(10, 2)
  balanceAfter Decimal  @db.Decimal(10, 2)
  vehicleId    Int?
  employeeId   Int?
  fuelLogId    Int?
  companyName  String?
  note         String?
  recordedAt   DateTime @default(now())
  createdById  Int?
  createdAt    DateTime @default(now())

  @@index([type])
  @@index([recordedAt])
  @@index([vehicleId])
  @@index([employeeId])
}

model MaintenanceLog {
  id          Int             @id @default(autoincrement())
  vehicleId   Int
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id])
  type        MaintenanceType
  description String
  cost        Decimal         @default(0) @db.Decimal(12, 2)
  odometer    Int?
  shop        String?
  date        DateTime
  note        String?
  completedAt DateTime?
  createdById Int?
  createdAt   DateTime        @default(now())

  @@index([vehicleId])
  @@index([date])
}

// === PURCHASES ===

model Purchase {
  id           Int            @id @default(autoincrement())
  purchaseNo   String         @unique
  supplierId   Int
  purchaseDate DateTime       @default(now())
  subtotal     Float
  total        Float
  status       PurchaseStatus @default(PENDING)
  note         String?
  createdById  Int
  createdAt    DateTime       @default(now())

  supplier  Supplier       @relation(fields: [supplierId], references: [id])
  createdBy User           @relation(fields: [createdById], references: [id])
  items     PurchaseItem[]

  @@index([purchaseDate])
}

model PurchaseItem {
  id            Int   @id @default(autoincrement())
  purchaseId    Int
  productId     Int
  productUnitId Int
  quantity      Float
  unitCost      Float
  lineTotal     Float

  purchase    Purchase    @relation(fields: [purchaseId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
}

// === RETURNS ===

model Return {
  id             Int          @id @default(autoincrement())
  returnNo       String       @unique
  originalSaleId Int
  customerId     Int?
  returnDate     DateTime     @default(now())
  reason         ReturnReason
  totalRefund    Float
  refundMethod   RefundMethod
  note           String?
  createdById    Int
  createdAt      DateTime     @default(now())

  originalSale Sale         @relation(fields: [originalSaleId], references: [id])
  customer     Customer?    @relation(fields: [customerId], references: [id])
  createdBy    User         @relation(fields: [createdById], references: [id])
  items        ReturnItem[]

  @@index([returnDate])
}

model ReturnItem {
  id             Int     @id @default(autoincrement())
  returnId       Int
  productId      Int
  productUnitId  Int
  customName     String?
  customUnitName String?
  quantity       Float
  quantityBase   Float
  restock        Boolean
  unitPrice      Float
  lineTotal      Float

  returnRec   Return      @relation(fields: [returnId], references: [id])
  product     Product     @relation(fields: [productId], references: [id])
  productUnit ProductUnit @relation(fields: [productUnitId], references: [id])
}

// === SETTINGS ===

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// === DEVICE & PRINTING ===

model Device {
  id                String          @id @default(cuid())
  name              String
  type              String          // "barcode_scanner" | "cash_drawer" | "face_scan_camera" | "receipt_printer" | "delivery_printer" | "other"
  icon              String          @default("device-desktop")
  location          String?
  connectionMethod  String          @default("manual") // "agent_heartbeat" | "activity_proxy" | "linked_device" | "manual"
  linkedDeviceId    String?
  linkedDevice      Device?         @relation("DeviceLink", fields: [linkedDeviceId], references: [id])
  linkedFrom        Device[]        @relation("DeviceLink")
  ipAddress         String?
  macAddress        String?
  usbVendorId       String?
  usbProductId      String?
  status            String          @default("unknown")
  lastSeenAt        DateTime?
  lastActivityAt    DateTime?
  offlineThresholdSec Int           @default(90)
  isActive          Boolean         @default(true)
  sortOrder         Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  apiKey            String?         @unique

  printJobs      PrintJob[]
  printerConfigs PrinterConfig[]
}

model PrintJob {
  id           String    @id @default(cuid())
  type         String    // "receipt" | "delivery_note" | "barcode_label"
  refId        String
  deviceId     String?
  device       Device?   @relation(fields: [deviceId], references: [id])
  method       String    @default("webusb") // "webusb" | "browser_print"
  status       String    @default("queued") // "queued" | "printed" | "failed"
  errorMessage String?
  printedById  String?
  printedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([type])
  @@index([refId])
  @@index([createdAt])
}

model PrinterConfig {
  id              String   @id @default(cuid())
  documentType    String   @unique // "receipt" | "delivery_note" | "barcode_label"
  defaultDeviceId String
  defaultDevice   Device   @relation(fields: [defaultDeviceId], references: [id])
  usbVendorId     String?
  usbProductId    String?
  updatedAt       DateTime @updatedAt
}

model BarcodeLabelBatch {
  id            String   @id @default(cuid())
  productIds    String[]
  template      String   // "a4_sheet_24" | "a4_sheet_12" | "thermal_roll"
  copiesPerItem Int      @default(1)
  printedById   String?
  createdAt     DateTime @default(now())
}
